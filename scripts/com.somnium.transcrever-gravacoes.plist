<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.somnium.transcrever-gravacoes</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/node</string>
        <string>/Users/alexandremendes/Desktop/Somnium Properties/transcrever-gravacoes.mjs</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/alexandremendes/Desktop/Somnium Properties</string>

    <!-- Corre a cada 3 minutos: apanha gravacoes pendentes e transcreve. -->
    <key>StartInterval</key>
    <integer>180</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/alexandremendes/Desktop/Somnium Properties/transcrever-gravacoes-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/alexandremendes/Desktop/Somnium Properties/transcrever-gravacoes-stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- ~/bin tem o ffmpeg (usado pelo whisper); ~/Library/Python/3.9/bin tem o whisper. -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/alexandremendes/bin:/Users/alexandremendes/Library/Python/3.9/bin</string>

        <!-- Base das Edge Functions (producao). Deixa como esta salvo se mudar de projecto. -->
        <key>SOMNIUM_API_BASE</key>
        <string>https://mjgusjuougzoeiyavsor.supabase.co/functions/v1</string>

        <!-- Autenticacao do worker no crm (rotas /gravacoes). Preencher com o valor
             de INTERNAL_API_KEY do .env do dashboard (NAO commitar com valor real). -->
        <key>INTERNAL_API_KEY</key>
        <string></string>

        <!-- Motor: whisper python (openai-whisper). Modelo small = bom equilibrio
             qualidade/velocidade para 8GB RAM em CPU. Sobe para medium se quiseres
             mais qualidade (mais lento). Para usar whisper.cpp (mais rapido), define
             WHISPER_MODEL com o caminho de um modelo ggml e instala whisper-cli. -->
        <key>WHISPER_PY</key>
        <string>/Users/alexandremendes/Library/Python/3.9/bin/whisper</string>

        <key>WHISPER_PY_MODEL</key>
        <string>small</string>

        <key>FFMPEG_BIN</key>
        <string>/Users/alexandremendes/bin/ffmpeg</string>
    </dict>
</dict>
</plist>
