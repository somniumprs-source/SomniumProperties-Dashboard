#!/usr/bin/env bash
# Auto-rebase contra origin/<branch> antes do push para evitar rejeições por non-fast-forward.
set -e

remote="$1"
branch="$(git symbolic-ref --short HEAD 2>/dev/null || true)"
[ -z "$branch" ] && exit 0

echo "[pre-push] fetch $remote/$branch..."
git fetch "$remote" "$branch" --quiet || exit 0

local_sha="$(git rev-parse "$branch")"
remote_sha="$(git rev-parse "$remote/$branch" 2>/dev/null || echo "")"
[ -z "$remote_sha" ] && exit 0
[ "$local_sha" = "$remote_sha" ] && exit 0

base="$(git merge-base "$branch" "$remote/$branch")"
if [ "$base" = "$remote_sha" ]; then
  exit 0
fi

echo "[pre-push] remoto à frente, a rebase..."
dirty=0
if ! git diff-index --quiet HEAD -- || [ -n "$(git ls-files --others --exclude-standard)" ]; then
  dirty=1
  git stash push -u -m "pre-push auto-stash $(date +%s)" >/dev/null
fi

if ! git pull --rebase "$remote" "$branch"; then
  echo "[pre-push] rebase falhou — resolve conflitos manualmente e tenta de novo."
  [ "$dirty" = "1" ] && echo "[pre-push] alterações guardadas em git stash (recupera com: git stash pop)"
  exit 1
fi

if [ "$dirty" = "1" ]; then
  git stash pop || {
    echo "[pre-push] conflito ao restaurar stash — resolve manualmente (git stash list)"
    exit 1
  }
fi

echo "[pre-push] rebase OK — a re-empurrar com novo HEAD."
git push "$remote" "$branch"
exit 1
